generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* =========================================================
   ENUMS
========================================================= */

enum Role {
  BUYER
  SELLER
  ADMIN
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

enum ReturnPickupStatus {
  NOT_STARTED
  REQUESTED
  PICKED_UP
}

enum RefundStatus {
  NOT_STARTED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SellerRegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/* =========================================================
   USER
========================================================= */

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String?
  role      Role     @default(BUYER)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())

  /* -------------------------------------------------------
     SETTINGS
  ------------------------------------------------------- */

  notificationsEnabled Boolean @default(true)

  /* -------------------------------------------------------
     MANAGE ACCOUNT
  ------------------------------------------------------- */

  alternatePhone     String?
  alternatePhoneHint String?

  seller             Seller?
  sellerRegistration SellerRegistration?

  cart          Cart[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  wishlist      Wishlist[]
  addresses     Address[]
}

/* =========================================================
   SELLER
========================================================= */

model Seller {
  id        String  @id @default(cuid())
  userId    String  @unique
  shopName  String
  ownerName String
  city      String
  address   String?
  approved  Boolean @default(false)

  user     User      @relation(fields: [userId], references: [id])
  products Product[]
}

/* =========================================================
   SELLER REGISTRATION
========================================================= */

model SellerRegistration {
  id     String @id @default(cuid())
  userId String @unique

  /* -------------------------------------------------------
     STEP 1 — MOBILE
  ------------------------------------------------------- */

  mobile         String
  mobileVerified Boolean @default(false)

  /* -------------------------------------------------------
     STEP 2 — BUSINESS DETAILS
  ------------------------------------------------------- */

  businessType String?
  businessName String?
  ownerName    String?

  /* -------------------------------------------------------
     STEP 3 — GST / PAN
  ------------------------------------------------------- */

  hasGst    Boolean?
  gstin     String?
  panNumber String?
  panName   String?
  panEmail  String?

  /* -------------------------------------------------------
     STEP 4 — PICKUP ADDRESS
  ------------------------------------------------------- */

  pickupAddress       String?
  pickupCity          String?
  pickupState         String?
  pickupPincode       String?
  pickupContactName   String?
  pickupContactMobile String?

  /* GPS coordinates of seller pickup location */
  pickupLatitude  Float?
  pickupLongitude Float?

  /* -------------------------------------------------------
     STEP 5 — BANK DETAILS
  ------------------------------------------------------- */

  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?

  /* -------------------------------------------------------
     STEP 6 — STORE DETAILS
  ------------------------------------------------------- */

  storeName String?

  /* -------------------------------------------------------
     STEP 7 — SUBMISSION
  ------------------------------------------------------- */

  termsAccepted Boolean   @default(false)
  submittedAt   DateTime?

  /* -------------------------------------------------------
     REGISTRATION STATUS
  ------------------------------------------------------- */

  status SellerRegistrationStatus @default(DRAFT)

  rejectionReason String?

  /* -------------------------------------------------------
     TIMESTAMPS
  ------------------------------------------------------- */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /* -------------------------------------------------------
     RELATION
  ------------------------------------------------------- */

  user User @relation(fields: [userId], references: [id])
}

/* =========================================================
   CATEGORY
========================================================= */

model Category {
  id   String @id @default(cuid())
  name String @unique

  products Product[]
}

/* =========================================================
   PRODUCT
========================================================= */

model Product {
  id          String @id @default(cuid())
  name        String
  description String
  price       Float
  stock       Int

  image     String
  images    String @default("[]")
  sizes     String @default("[]")
  colors    String @default("[]")
  sizeChart String @default("")

  sellerId   String
  categoryId String

  seller   Seller   @relation(fields: [sellerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  cartItems  Cart[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlist   Wishlist[]

  createdAt DateTime @default(now())
}

/* =========================================================
   CART
========================================================= */

model Cart {
  id        String @id @default(cuid())
  userId    String
  productId String

  quantity Int    @default(1)
  size     String?
  color    String?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

/* =========================================================
   WISHLIST
========================================================= */

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  /* One user can save a product only once */
  @@unique([userId, productId])
}

/* =========================================================
   ADDRESS
   Customer saved addresses for Manage Account
========================================================= */

model Address {
  id     String @id @default(cuid())
  userId String

  name   String
  mobile String

  addressLine1 String
  addressLine2 String?
  landmark     String?

  city    String
  state   String
  pincode String

  type      String  @default("HOME")
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/* =========================================================
   ORDER
========================================================= */

model Order {
  id          String  @id @default(cuid())
  userId      String
  totalAmount Float

  status OrderStatus @default(PENDING)

  /* Customer delivery address */
  address String

  /* -------------------------------------------------------
     SELLER DELIVERY OTP
  ------------------------------------------------------- */

  sellerPickupOtp String?

  sellerPickupOtpExpiresAt DateTime?

  sellerPickupOtpAttempts Int @default(0)

  sellerPickupOtpLockedUntil DateTime?

  sellerOtpVerifiedAt DateTime?

  /* -------------------------------------------------------
     CUSTOMER DELIVERY OTP
  ------------------------------------------------------- */

  customerDeliveryOtp String?

  customerDeliveryOtpExpiresAt DateTime?

  customerDeliveryOtpAttempts Int @default(0)

  customerDeliveryOtpLockedUntil DateTime?

  customerOtpVerifiedAt DateTime?

  /* -------------------------------------------------------
     DELIVERY TIMESTAMPS
  ------------------------------------------------------- */

  pickedUpAt DateTime?

  deliveredAt DateTime?

  /* -------------------------------------------------------
     RETURN WINDOW
  ------------------------------------------------------- */

  returnDeadline DateTime?

  returnStatus ReturnStatus @default(NOT_ELIGIBLE)

  returnRequestedAt DateTime?

  returnReason String?

  returnRejectedReason String?

  returnCompletedAt DateTime?

  /* -------------------------------------------------------
     RETURN PICKUP
  ------------------------------------------------------- */

  returnPickupStatus ReturnPickupStatus @default(NOT_STARTED)

  returnPickupOtp String?

  returnPickupOtpExpiresAt DateTime?

  returnPickupOtpVerifiedAt DateTime?

  returnPickupOtpAttempts Int @default(0)

  returnPickupOtpLockedUntil DateTime?

  returnPickedUpAt DateTime?

  /* -------------------------------------------------------
     REFUND
  ------------------------------------------------------- */

  refundStatus RefundStatus @default(NOT_STARTED)

  refundAmount Float?

  refundRequestedAt DateTime?

  refundCompletedAt DateTime?

  refundFailureReason String?

  /* -------------------------------------------------------
     PAYMENT
  ------------------------------------------------------- */

  paymentMethod PaymentMethod @default(COD)

  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId String?

  razorpayPaymentId String?

  razorpaySignature String?

  paidAt DateTime?

  /* -------------------------------------------------------
     RELATIONS
  ------------------------------------------------------- */

  user User @relation(fields: [userId], references: [id])

  items OrderItem[]

  /* -------------------------------------------------------
     TIMESTAMPS
  ------------------------------------------------------- */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================================================
   ORDER ITEM
========================================================= */

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  quantity Int
  price    Float

  returnStatus ReturnStatus @default(NOT_ELIGIBLE)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

/* =========================================================
   REVIEW
========================================================= */

model Review {
  id        String  @id @default(cuid())
  userId    String
  productId String

  rating  Int
  comment String?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

/* =========================================================
   NEARBY SHOP
========================================================= */

model NearbyShop {
  id   String @id @default(cuid())
  name String
  city String
  area String
}

/* =========================================================
   NOTIFICATION
========================================================= */

model Notification {
  id      String  @id @default(cuid())
  title   String
  message String
  type    String

  isRead Boolean @default(false)

  userId String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}